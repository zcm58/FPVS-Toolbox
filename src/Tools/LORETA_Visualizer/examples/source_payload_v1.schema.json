{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fpvs-toolbox.local/schemas/loreta/source_payload_v1.schema.json",
  "title": "FPVS LORETA Visualizer Prepared Source Payload v1",
  "description": "Shape-only schema for already-computed source payloads. The Python validator enforces cross-field rules such as one value per point and face-index bounds.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "format",
    "coordinate_space",
    "points",
    "values"
  ],
  "properties": {
    "format": {
      "const": "fpvs-loreta-source-payload-v1"
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "roi_mesh",
        "surface_mesh",
        "surface_points",
        "volume_mesh",
        "volume_points"
      ]
    },
    "coordinate_space": {
      "type": "string",
      "minLength": 1
    },
    "source_model": {
      "type": "string",
      "minLength": 1
    },
    "value_label": {
      "type": "string",
      "minLength": 1
    },
    "points": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 3,
        "maxItems": 3,
        "items": {
          "type": "number"
        }
      }
    },
    "values": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": [
          "number",
          "null"
        ]
      }
    },
    "faces": {
      "oneOf": [
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        }
      ]
    },
    "metadata": {
      "type": "object",
      "properties": {
        "source_metric": {
          "type": "string"
        },
        "source_value_polarity": {
          "type": "string"
        },
        "source_comparison_role": {
          "enum": ["left", "right", "difference"]
        },
        "descriptive_comparison": {
          "type": "object",
          "required": ["version", "kind", "direction"],
          "properties": {
            "version": {"const": 1},
            "kind": {"enum": ["groups", "conditions"]},
            "direction": {"const": "A-B"}
          }
        },
        "source_validity": {
          "type": "object",
          "required": [
            "policy",
            "version",
            "scope",
            "source_count",
            "valid_source_count",
            "invalid_source_indices"
          ],
          "properties": {
            "policy": {
              "const": "complete_valid_source_support_v1"
            },
            "version": {
              "const": 1
            },
            "scope": {
              "enum": [
                "participant",
                "group_complete_case"
              ]
            },
            "source_count": {
              "type": "integer",
              "minimum": 1
            },
            "valid_source_count": {
              "type": "integer",
              "minimum": 1
            },
            "invalid_source_indices": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "integer",
                "minimum": 0
              }
            },
            "participant_count": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["source_metric"],
            "properties": {"source_metric": {"const": "baseline_corrected_amplitude"}}
          },
          "then": {
            "required": ["source_value_polarity"],
            "properties": {"source_value_polarity": {"const": "signed"}}
          }
        },
        {
          "if": {"required": ["descriptive_comparison"]},
          "then": {
            "required": ["source_value_polarity", "source_comparison_role"],
            "properties": {"source_value_polarity": {"const": "signed"}}
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "values": {
            "contains": {
              "type": "null"
            }
          }
        }
      },
      "then": {
        "required": [
          "metadata"
        ],
        "properties": {
          "metadata": {
            "required": [
              "source_validity"
            ]
          }
        }
      }
    }
  ]
}
